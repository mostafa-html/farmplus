# .env.example
# Copy this file to .env and fill in your values before running the stack.
#
#   cp .env.example .env
#
# Generate a secure Django secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production

# ── Database (TimescaleDB / PostgreSQL) ──────────────────────────────────────
POSTGRES_DB=farmpulse
POSTGRES_USER=farmpulse_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── EMQX MQTT Broker ─────────────────────────────────────────────────────────
# Generate a random cookie with: python -c "import secrets; print(secrets.token_hex(32))"
EMQX_NODE_COOKIE=replace-with-random-hex-string
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change_me_emqx_password

# ── App Image ─────────────────────────────────────────────────────────────────
# Must match the tag used in: docker build -t <this-value> .
FARMPULSE_IMAGE=farmpulse-app:latest
